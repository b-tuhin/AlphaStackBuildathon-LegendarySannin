# Auth
JWT_SECRET=change_me_in_production

# Twilio (leave blank + TWILIO_MOCK=true to log SMS/IVR to console — zero setup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MOCK=true

# Your machine's LAN IP (needed so Expo Go on your phone can reach Metro/API)
HOST_IP=192.168.1.100
