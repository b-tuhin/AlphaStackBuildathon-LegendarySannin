# Auth
# REQUIRED in production. Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
# Optional JWT access-token lifetime (default: 7d)
# JWT_EXPIRES_IN=7d

# Phone verification and transactional SMS
# OTP_MODE=twilio uses Twilio Verify and requires an approved phone-bound grant.
# OTP_MODE=password preserves the legacy password-only signup/login fallback;
# phone ownership is not verified in that mode. Password resets always use
# Twilio Verify and therefore need its service credentials configured.
OTP_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Required for SMS notifications and IVR welcome/password messages
TWILIO_PHONE_NUMBER=
# Never enable mock SMS in production. Mock delivery is disabled by default.
TWILIO_MOCK=false
# Public HTTPS origin Twilio calls, without a trailing slash (ngrok example below)
PUBLIC_BASE_URL=https://your-public-host.example
# Optional Terms version recorded on account creation
TOS_VERSION=2026-09-30

# Your machine's LAN IP (needed so Expo Go on your phone can reach Metro/API)
HOST_IP=192.168.1.100
# Set true only behind a trusted proxy that rewrites X-Forwarded-For.
# TRUST_PROXY=false
# WEB_DOMAIN=phonemail.com
# ANDROID_SMS_HASH=FA+9qCX9VSu

# Local webhook development:
#   1. Start the backend on port 4000.
#   2. Run: ngrok http 4000
#   3. Set PUBLIC_BASE_URL to the displayed https://<id>.ngrok-free.app origin.
#   4. In Twilio, set Voice URL to <PUBLIC_BASE_URL>/webhooks/ivr (POST),
#      and any inbound-SMS webhook to <PUBLIC_BASE_URL>/webhooks/sms (POST).
#   5. For local production-like testing, supply these values through the
#      deployment environment; never commit credentials or edit .env here.
