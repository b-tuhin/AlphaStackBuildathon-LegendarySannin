# Auth
# REQUIRED in production — the backend refuses to start if this is missing or equals
# the example placeholder.  Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Optional: JWT access-token lifetime (default: 7d).  Use a shorter value (e.g.
# 15m) if you add a refresh-token endpoint.
# JWT_EXPIRES_IN=7d

# Twilio (leave blank + TWILIO_MOCK=true to log SMS/IVR to console — zero setup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MOCK=true

# Your machine's LAN IP (needed so Expo Go on your phone can reach Metro/API)
HOST_IP=192.168.1.100

# Set to "true" only when the backend sits behind a trusted reverse proxy that
# strips and re-writes X-Forwarded-For.  Leaving this unset (or "false") makes
# the IP portion of rate-limit keys use the raw socket address instead.
# TRUST_PROXY=false

# Domain name for WebOTP API origin binding in SMS messages (e.g. phonemail.com or localhost:3000)
# WEB_DOMAIN=phonemail.com

# 11-character app signature hash for Google SMS Retriever API on Android
# ANDROID_SMS_HASH=FA+9qCX9VSu
